module modules

import std/text
import std/semantic_version::{SemanticVersion}
import std/time::{Time}
import toml::{toml_string}

# What update.iyi needs to know about iyi modules, apart from fetching them,
# and what the site says about their age. An iyi module is a GitHub
# repository whose root holds an iyi.mod naming it github.com/OWNER/REPO, as
# `iyi get` requires; its versions are its vMAJOR.MINOR.PATCH tags.

# The fields of a module in data/modules.toml, in the order written.
MODULE_FIELDS = ["slug", "name", "module", "repo", "category", "description", "source", "homepage", "usage", "license", "distribution",
                 "stars", "forks", "issues", "watchers", "contributors", "created", "pushed", "version", "released", "requires", "dependents", "topics"]

# GitHub topics that put a module in a category, in the order the categories
# are tried. A module without any of them is in "other".
CATEGORY_TOPICS = [
  {"web", ["http", "https", "web", "websocket", "websockets", "server", "client", "network", "networking", "socket", "api", "rest", "router", "framework", "web-framework"]},
  {"data", ["json", "yaml", "toml", "csv", "xml", "serialization", "database", "db", "sql", "sqlite", "postgres", "postgresql", "mysql", "redis", "orm", "msgpack", "protobuf"]},
  {"text", ["template", "templates", "templating", "template-engine", "template-language", "html", "markdown", "text", "string", "strings", "i18n", "formatting", "slim", "parser"]},
  {"system", ["cli", "command-line", "terminal", "shell", "process", "filesystem", "file", "files", "logging", "log", "testing", "test", "build", "tool", "tooling", "devtools"]},
  {"utilities", ["time", "date", "uuid", "random", "crypto", "cryptography", "hash", "math", "utility", "utilities", "util", "collections"]},
]

# The `module` path an iyi.mod declares, or nil.
pub def module_path(text : String) : String?
  text.lchop('﻿').each_line do |raw|
    fields = raw.strip.split
    next if fields.empty? || fields[0].starts_with?("#")
    return fields[1]? if fields[0] == "module"
  end
  nil
end

# The module paths an iyi.mod requires.
pub def requirements(text : String) : Array(String)
  paths = [] of String
  text.each_line do |raw|
    fields = raw.strip.split
    paths << fields[1] if fields.size >= 3 && fields[0] == "require"
  end
  paths
end

# Whether *text* names the module at github.com/*repo*, as `iyi get` requires.
pub def gettable?(text : String, repo : String) : Bool
  path = module_path(text)
  !path.nil? && path.downcase == "github.com/#{repo}".downcase
end

# The highest vMAJOR.MINOR.PATCH among *tags*, or nil.
pub def latest_version(tags : Array(String)) : String?
  best = nil
  best_version = SemanticVersion.new(0, 0, 0)
  tags.each do |tag|
    next unless tag.starts_with?("v")
    version = SemanticVersion.parse?(tag[1, tag.size])
    next unless version
    if best.nil? || version > best_version
      best = tag
      best_version = version
    end
  end
  best
end

pub def category_for(topics : Array(String)) : String
  CATEGORY_TOPICS.each do |entry|
    return entry[0] if topics.any? { |topic| entry[1].includes?(topic.downcase) }
  end
  "other"
end

# How many of *records* require each module path.
pub def dependents(records : Array(Hash(String, String))) : Hash(String, Int32)
  counts = {} of String => Int32
  records.each do |record|
    record["requires"].split.uniq.each do |path|
      counts[path.downcase] = (counts[path.downcase]? || 0) + 1
    end
  end
  counts
end

# data/modules.toml for *records*: one [[modules]] table each, its fields
# in MODULE_FIELDS order.
pub def modules_toml(records : Array(Hash(String, String)), imported : String) : String
  text = "# Generated by `make update` on #{imported} from GitHub; do not edit.\n"
  text += "# Overrides go in [[modules]] of data/catalog.toml.\n"
  records.each do |record|
    text += "\n[[modules]]\n"
    MODULE_FIELDS.each { |key| text += "#{key} = #{toml_string(record[key]? || "")}\n" }
  end
  text
end

pub def days_since(date : String, now : Time) : Int64
  (now - Time.parse_rfc3339(date)).days
end

# "Active", "Quiet" or "Inactive" by the last push.
pub def activity(pushed : String, now : Time) : String
  return "" if pushed.empty?
  days = days_since(pushed, now)
  return "Active" if days <= 90
  return "Quiet" if days <= 365
  "Inactive"
end

# "today", "3 days ago", "5 months ago", "2 years ago".
pub def ago(date : String, now : Time) : String
  return "" if date.empty?
  days = days_since(date, now)
  return "today" if days < 1
  return plural(days, "day") + " ago" if days < 60
  return plural(days // 30, "month") + " ago" if days < 730
  plural(days // 365, "year") + " ago"
end

def plural(count : Int64, word : String) : String
  count == 1 ? "1 #{word}" : "#{count} #{word}s"
end
