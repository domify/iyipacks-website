# The program `Slang.embed` runs at compile time: `slang/process CALLER
# TEMPLATE BUFFER` reads the template named beside CALLER (or by an absolute
# path) and prints the iyi source that renders it into BUFFER. The original
# shard's src/slang/process.cr does the same for Crystal.
#
# The lexer, the parser and the node tree are toddsundsted/slang 2.0.3's,
# kept in the same order; templates fail here with their line, and the
# compiler reports errors in the generated code at the template's line.
module slang_process

import std/text

class Token
  # The type of token: ELEMENT, ATTRIBUTE, SPLAT, TEXT, OUTPUT, CONTROL,
  # CODE, COMMENT, DOCTYPE, WRAPPER, NEWLINE or EOF.
  property type : String

  # If `text_block` is true, `column_number` is the column of the markup
  # character that begins the block of text, not the column of the first
  # text character in the block.
  property line_number : Int32
  property column_number : Int32

  # An element's or attribute's name.
  property name : String?

  # The token's text: code, or a string literal for text.
  property value : String?

  # The value is wrapped in `Slang.escape` when it is rendered.
  property escaped : Bool

  # The token is on the same line as the previous token.
  property inline : Bool

  # Comments: `visible` ones are rendered as HTML comments, and
  # `conditional` holds the logic of a conditional comment.
  property visible : Bool
  property conditional : String

  # A space before/after the token.
  property prepend_whitespace : Bool
  property append_whitespace : Bool

  # The token is part of a block of raw text.
  property raw_text : Bool

  # The token is the first line of a block of verbatim text.
  property text_block : Bool

  # A splat attribute's variable name.
  property splat : String?

  # An element's `#id` and `.class` names, as string literals.
  property id : String?
  getter classes : Array(String)

  def initialize
    @type = "EOF"
    @line_number = 0
    @column_number = 0
    @name = nil
    @value = nil
    @escaped = true
    @inline = false
    @visible = true
    @conditional = ""
    @prepend_whitespace = false
    @append_whitespace = false
    @raw_text = false
    @text_block = false
    @splat = nil
    @id = nil
    @classes = [] of String
  end

  def add_class(value : String) : Nil
    @classes << value unless @classes.includes?(value)
  end
end

class Lexer
  RAWSTUFF = {"javascript:" => "script", "css:" => "style", "crystal:" => "*code*", "iyi:" => "*code*"}
  ATTR_OPEN_CLOSE_MAP = {'{' => '}', '[' => ']', '(' => ')', ' ' => ' '}
  STRING_OPEN_CLOSE_CHARS_MAP = {'(' => ')', '{' => '}', '[' => ']', '<' => '>'}

  getter token : Token
  @chars : Array(Char)

  def initialize(string : String)
    @chars = string.chars
    @chars << '\0'
    @pos = 0
    @token = Token.new
    @parsing_text = false
    @code_block_column_number = 0
    @line_number = 1
    @column_number = 1
    @last_token = @token
    @last_delimiter = ' '
    @raw_text_column = 0
  end

  def next_token : Token
    loop do
      next_token_internal
      break unless @token.type == "NEWLINE" || @token.type == "WRAPPER"
    end
    @last_token = @token
    @token
  end

  private def next_token_internal : Nil
    skip_whitespace unless @parsing_text

    @token = Token.new
    @token.line_number = @line_number
    @token.column_number = @column_number

    if @raw_text_column > 0 && @column_number < @raw_text_column
      @raw_text_column = 0
    end

    inline = @raw_text_column > 0 || (["ELEMENT", "ATTRIBUTE", "SPLAT", "TEXT"].includes?(@last_token.type) && @last_token.line_number == @line_number)

    if @column_number <= @code_block_column_number
      @code_block_column_number = 0
    end

    c = current_char
    if @code_block_column_number > 0
      if c == '\0'
        @token.type = "EOF"
      elsif c == '\r' || c == '\n'
        consume_newline
      else
        @token.type = "TEXT"
        text = consume_line(false)
        @token.value = text
        @token.raw_text = true
        @token.escaped = false
        @raw_text_column = @column_number - text.chars.size
      end
      return
    end

    if c == '\0'
      @token.type = "EOF"
    elsif c == '\r' || c == '\n'
      consume_newline
    elsif c == '.' || c == '#' || c.ascii_letter?
      if inline
        if c.ascii_letter?
          current_attr_name = consume_html_valid_name
          if current_char == '='
            open_char = @last_delimiter
            close_char = ATTR_OPEN_CLOSE_MAP[@last_delimiter]
            @token.type = "ATTRIBUTE"
            @token.name = current_attr_name
            @token.value = consume_value(open_char, close_char)
          else
            go_back(current_attr_name.chars.size)
            @token.escaped = false
            consume_text
          end
        elsif c == '#' && peek_next_char == '{'
          consume_string_interpolation_text
        else
          @token.escaped = false
          consume_text
        end
      else
        @token.escaped = false
        consume_element
      end
    elsif c == ':'
      @token.escaped = false
      if inline && @last_token.type != "ELEMENT"
        consume_text
      else
        consume_inline_element
      end
    elsif c == '-'
      @token.escaped = false
      consume_control
    elsif c == '='
      consume_output
    elsif c == '|' || c == '\''
      @token.escaped = false
      if inline
        consume_text
      else
        @token.text_block = true
        @token.append_whitespace = c == '\''
        next_char
        skip_whitespace
        consume_text
        @raw_text_column = (@column_number - (@token.value || "").chars.size) + 2 # +2 for the quotation marks
      end
    elsif c == '<'
      @token.escaped = false
      consume_text
    elsif c == '/'
      consume_comment
    elsif c == '*'
      if inline && (@last_token.type == "ELEMENT" || @last_token.type == "ATTRIBUTE")
        consume_splat
      else
        unexpected_char
      end
    elsif inline
      # matching pairs of open/close chars should be ignored
      if ATTR_OPEN_CLOSE_MAP.has_key?(c) && @last_token.type == "ELEMENT"
        @token.type = "WRAPPER"
        @last_delimiter = c
        next_char
      elsif ATTR_OPEN_CLOSE_MAP.values.includes?(c) && @last_token.type == "ATTRIBUTE"
        # The original kept the closing char here, and the next attribute
        # failed to find its pair.
        @token.type = "WRAPPER"
        @last_delimiter = ' '
        next_char
      else
        @token.escaped = false
        consume_text
      end
    else
      unexpected_char
    end

    @token.raw_text = @raw_text_column > 0
    @token.inline = inline unless @raw_text_column > 0

    if @token.type == "TEXT"
      if @last_token.line_number == @token.line_number && @last_token.column_number < @token.column_number
        @token.inline = true
      end
    end
  end

  private def consume_element : Nil
    @token.type = "ELEMENT"
    @token.name = "div"
    @last_delimiter = ' '

    loop do
      c = current_char
      if c.ascii_letter?
        consume_element_name
      elsif c == '.'
        next_char # skip the '.' at the beginning
        @token.add_class(consume_html_valid_name.inspect)
      elsif c == '#'
        next_char # skip the '#' at the beginning
        @token.id = consume_html_valid_name.inspect
      elsif c == '<'
        @token.prepend_whitespace = true
        next_char
      elsif c == '>'
        @token.append_whitespace = true
        next_char
      else
        break
      end
    end
  end

  private def consume_inline_element : Nil
    next_char # skip ':'
    skip_whitespace
    consume_element
  end

  private def consume_element_name : Nil
    column_number = @column_number
    name = check_raw_text_header(consume_html_valid_name)
    @token.name = name
    if name == "doctype"
      @token.type = "DOCTYPE"
      next_char if current_char == ' '
      @token.value = consume_line(true)
    elsif name == "*code*"
      @code_block_column_number = column_number
      @token.type = "CODE"
      @token.name = nil
      consume_line(false)
    end
  end

  private def consume_html_valid_name : String
    name = ""
    loop do
      c = current_char
      if c == ':'
        break if ATTR_OPEN_CLOSE_MAP.has_key?(peek_next_char)
      elsif !(c.ascii_alphanumeric? || c == '-' || c == '_')
        break
      end
      name += c.to_s
      next_char
    end
    name
  end

  private def check_raw_text_header(name : String) : String
    if raw = RAWSTUFF[name]?
      @raw_text_column = (@column_number - name.chars.size) + 2
      raw
    else
      name
    end
  end

  private def consume_splat : Nil
    @token.type = "SPLAT"
    next_char # skip '*'
    @token.value = consume_html_valid_name
  end

  private def consume_comment : Nil
    @token.type = "COMMENT"
    next_char
    if current_char == '!'
      @token.visible = true
      next_char
    elsif current_char == '['
      @token.visible = true
      next_char
      conditional = ""
      loop do
        c = current_char
        if c == ']'
          next_char
          break
        elsif c == '\0' || c == '\n' || c == '\r'
          break
        else
          conditional += c.to_s
          next_char
        end
      end
      @token.conditional = conditional
    else
      @token.visible = false
    end
    skip_whitespace
    @token.value = consume_line(true) if @token.conditional.empty?
  end

  private def consume_control : Nil
    @token.type = "CONTROL"
    next_char
    next_char if current_char == ' '
    @token.value = consume_line(false)
  end

  private def consume_output : Nil
    @token.type = "OUTPUT"
    next_char
    if current_char == '='
      @token.escaped = false
      next_char
    end
    if current_char == '<'
      @token.prepend_whitespace = true
      next_char
    end
    if current_char == '>'
      @token.append_whitespace = true
      next_char
    end
    skip_whitespace
    @token.value = consume_line(false).strip
  end

  private def consume_text : Nil
    @token.type = "TEXT"
    @token.value = "\"#{consume_string('"', '"', true, true)}\""
    @parsing_text = true
  end

  private def consume_string_interpolation_text : Nil
    @token.type = "TEXT"
    next_char # skip '#'
    next_char # skip '{'
    @token.value = consume_string_interpolation
  end

  private def consume_string_interpolation : String
    maybe_string = false
    text = ""
    loop do
      c = current_char
      maybe_string = true if c == '%'
      if maybe_string && STRING_OPEN_CLOSE_CHARS_MAP.has_key?(c)
        text += c.to_s
        next_char
        text += consume_string(c, STRING_OPEN_CLOSE_CHARS_MAP[c], false, false)
        next
      end
      if c == '"' || c == '\''
        text += c.to_s
        next_char
        text += consume_string(c, c, false, false)
        next
      end
      if c == '}'
        next_char
        @parsing_text = true
        break
      end
      break if c == '\n' || c == '\r' || c == '\0'
      text += c.to_s
      next_char
    end
    text
  end

  private def consume_string(open_char : Char, close_char : Char, escape_double_quotes : Bool, break_on_interpolation : Bool) : String
    level = 0
    escaped = false
    maybe_string_interpolation = false
    text = ""
    loop do
      if escape_double_quotes
        if current_char == '"'
          text += "\\\""
          next_char
          next
        end
      else
        if (close_char == '"' || close_char == '\'') && current_char == close_char && !escaped
          text += current_char.to_s
          next_char
          break
        end
        level += 1 if current_char == open_char && !escaped && !maybe_string_interpolation
        if current_char == close_char && !escaped
          if level == 0
            text += current_char.to_s
            next_char
            break
          end
          level -= 1
        end
      end

      if maybe_string_interpolation
        maybe_string_interpolation = false
        if current_char == '{'
          text += consume_string_interpolation
          text += "}"
          next
        end
      end
      if current_char == '#' && !escaped
        maybe_string_interpolation = true
        break if peek_next_char == '{' && break_on_interpolation
      end

      escaped = current_char == '\\' && !escaped

      break if current_char == '\n' || current_char == '\r' || current_char == '\0'
      text += current_char.to_s
      next_char
    end
    text
  end

  # The rest of the line; written into a string literal when
  # *escape_double_quotes*.
  private def consume_line(escape_double_quotes : Bool) : String
    line = ""
    loop do
      c = current_char
      break if c == '\n' || c == '\r' || c == '\0'
      line += "\\" if escape_double_quotes && (c == '"' || c == '\\')
      line += c.to_s
      next_char
    end
    line
  end

  private def consume_value(open_char : Char, close_char : Char) : String
    value = ""
    open_count = 0
    is_in_parenthesis = false
    loop do
      c = current_char
      if c == '='
        next_char
        if current_char == '"'
          value += current_char.to_s
          next_char
          value += consume_string('"', '"', false, false)
          break
        end
      elsif c == ' '
        break if open_count == 0
        break unless is_in_parenthesis
        value += c.to_s
        next_char
      elsif c == open_char
        open_count += 1
        value += c.to_s
        next_char
      elsif c == close_char
        break if open_count == 0
        open_count -= 1
        value += c.to_s
        next_char
      elsif c == '('
        open_count += 1
        is_in_parenthesis = true
        value += c.to_s
        next_char
      elsif c == ')'
        open_count -= 1
        is_in_parenthesis = false
        value += c.to_s
        next_char
      elsif c == '\n' || c == '\r' || c == '\0'
        break
      else
        value += c.to_s
        next_char
      end
    end
    value
  end

  private def consume_newline : Nil
    c = current_char
    loop do
      if c == '\r'
        raise "slang expected '\\n' after '\\r' at line #{@line_number}" unless peek_next_char == '\n'
        next_char
      elsif c != '\n'
        break
      end
      @line_number += 1
      @column_number = 0
      c = next_char
    end
    @parsing_text = false
    @token.line_number = @line_number
    @token.column_number = @column_number
    @token.type = "NEWLINE"
  end

  private def go_back(count : Int32) : Nil
    @column_number -= count
    @pos -= count
  end

  private def next_char : Char
    @column_number += 1
    @pos += 1 if @pos < @chars.size - 1
    current_char
  end

  private def peek_next_char : Char
    @pos + 1 < @chars.size ? @chars[@pos + 1] : '\0'
  end

  private def current_char : Char
    @chars[@pos]
  end

  private def skip_whitespace : Nil
    while current_char == ' ' || current_char == '\t'
      next_char
    end
  end

  private def unexpected_char : Nil
    raise "slang: unexpected char '#{current_char}' at line #{@line_number}, column #{@column_number}"
  end
end

# The generated code, a line at a time.
class Writer
  getter lines : Array(String)
  getter filename : String

  def initialize(@filename : String)
    @lines = [] of String
    @names = 0
  end

  def <<(line : String) : Writer
    @lines << line
    self
  end

  # The template position of *token*, for code the compiler may refuse.
  def loc(token : Token) : String
    "#<loc:#{@filename.inspect},#{token.line_number},#{token.column_number}>"
  end

  # A buffer name no other block in this template uses.
  def unique(buffer : String) : String
    @names += 1
    "#{buffer}_#{@names}"
  end
end

# The original's Document, Element, Attribute, Text, Code, Control, Comment
# and Doctype classes, as one class told apart by `kind`.
class Node
  SELF_CLOSING_TAGS = ["area", "base", "br", "col", "embed", "hr", "img", "input", "keygen", "link", "menuitem", "meta", "param", "source", "track", "wbr"]

  getter kind : String
  getter token : Token
  getter nodes : Array(Node)
  getter branches : Array(Node)
  @parent : Node?

  def initialize(@kind : String, @parent : Node?, @token : Token)
    @nodes = [] of Node
    @branches = [] of Node
  end

  def parent : Node
    @parent || self
  end

  def document? : Bool
    @kind == "document"
  end

  def column_number : Int32
    @token.column_number
  end

  def value : String
    @token.value || ""
  end

  def children? : Bool
    !@nodes.empty?
  end

  def printable_parents_count : Int32
    count = 0
    current = parent
    until current.document? || current.kind == "element" || current.kind == "code" || current.token.text_block || @token.text_block
      count += 1
      current = current.parent
    end
    count
  end

  def indent? : Bool
    !@token.inline && printable_parents_count > 0
  end

  def indentation : String
    "  " * printable_parents_count
  end

  # Control nodes: which branches (`else`, `when`, ...) belong to them.
  def starts?(word : String) : Bool
    value == word || value.starts_with?("#{word} ")
  end

  def branch? : Bool
    starts?("else") || starts?("elsif") || starts?("rescue") || starts?("ensure") || starts?("when") || starts?("in")
  end

  def allow_branch?(branch : Node) : Bool
    return false unless branch.kind == "control"
    if starts?("if")
      branch.starts?("else") || branch.starts?("elsif")
    elsif starts?("begin")
      branch.starts?("rescue") || branch.starts?("ensure") || branch.starts?("else")
    elsif starts?("case")
      branch.starts?("in") || branch.starts?("when") || branch.starts?("else")
    else
      false
    end
  end

  def to_s(w : Writer, buffer : String) : Nil
    if @kind == "document"
      w << "#<loc:push>"
      @nodes.each { |node| node.to_s(w, buffer) }
      w << "#<loc:pop>"
    elsif @kind == "doctype"
      w << "#{buffer} << \"<!DOCTYPE #{value}>\""
    elsif @kind == "element"
      element(w, buffer)
    elsif @kind == "control"
      w << "#{w.loc(@token)}#{value}"
      @nodes.each { |node| node.to_s(w, buffer) }
      @branches.each { |branch| branch.to_s(w, buffer) }
      w << "end" if (!branch? && children?) || !@branches.empty?
    elsif @kind == "code"
      code(w, self)
    elsif @kind == "comment"
      comment(w, buffer)
    elsif @kind == "text"
      text(w, buffer)
    end
    # Attributes are written by their element.
  end

  private def element(w : Writer, buffer : String) : Nil
    name = @token.name || "div"
    attributes = @nodes.select { |node| node.kind == "attribute" }
    splat = @token.splat
    w << "#{buffer} << \" \"" if @token.prepend_whitespace
    w << "#{buffer} << \"<#{name}\""
    if id = attributes.find { |attribute| attribute.token.name == "id" }
      w << "::Slang::Slang.attribute(#{buffer}, \"id\", (#{w.loc(id.token)}#{id.value}))"
    end
    classes = attributes.select { |attribute| attribute.token.name == "class" }.map { |attribute| "(#{w.loc(attribute.token)}#{attribute.value}).to_s" }
    classes << "(#{splat})[\"class\"]?.to_s" if splat
    w << "::Slang::Slang.class_attribute(#{buffer}, [#{classes.join(", ")}])" unless classes.empty?
    attributes.each do |attribute|
      attribute_name = attribute.token.name || ""
      next if attribute_name == "id" || attribute_name == "class"
      w << "::Slang::Slang.attribute(#{buffer}, \"#{attribute_name}\", (#{w.loc(attribute.token)}#{attribute.value}))"
    end
    w << "::Slang::Slang.splat(#{buffer}, (#{splat}))" if splat
    w << "#{buffer} << \">\""
    @nodes.each { |node| node.to_s(w, buffer) }
    w << "#{buffer} << \"</#{name}>\"" unless SELF_CLOSING_TAGS.includes?(name)
    w << "#{buffer} << \" \"" if @token.append_whitespace
  end

  private def first_child? : Bool
    parent.nodes.first == self && (parent.kind == "element" || parent.document?)
  end

  private def empty_parent? : Bool
    parent_value = parent.value
    parent.token.text_block && parent_value.size >= 2 && parent_value.starts_with?("\"") && parent_value.ends_with?("\"") && parent_value[1, parent_value.size - 2].blank?
  end

  private def text(w : Writer, buffer : String) : Nil
    w << "#{buffer} << \" \"" if @token.prepend_whitespace
    w << "#{buffer} << \"\\n\"" if @token.raw_text && !first_child? && !@token.text_block && !empty_parent? && !@token.inline
    w << "#{buffer} << \"#{indentation}\"" if indent? && @token.raw_text
    open, close = @token.escaped ? {"::Slang::Slang.escape((", "))"} : {"((", ").to_s)"}
    if @token.type == "OUTPUT" && children?
      # `= expr do` passes the block's HTML to the method as a String.
      sub = w.unique(buffer)
      w << "#{buffer} << #{open}#{w.loc(@token)}#{value}"
      w << "String.build do |#{sub}|"
      @nodes.each { |node| node.to_s(w, sub) }
      w << "end"
      w << "end#{close}"
    else
      w << "#{buffer} << #{open}#{w.loc(@token)}#{value}\n#{close}"
      @nodes.each { |node| node.to_s(w, buffer) }
    end
    w << "#{buffer} << \" \"" if @token.append_whitespace
  end

  # A `crystal:` or `iyi:` block: its lines are code, as they are.
  private def code(w : Writer, node : Node) : Nil
    unless node.value.blank?
      w << "#{node.indent? ? node.indentation : ""}#{w.loc(node.token)}#{node.value}"
    end
    node.nodes.each { |child| code(w, child) }
  end

  private def comment(w : Writer, buffer : String) : Nil
    return unless @token.visible
    conditional = @token.conditional
    w << "#{buffer} << \"#{indentation}\"" if indent?
    w << "#{buffer} << \"<!--\""
    w << "#{buffer} << \"[#{conditional}]>\"" unless conditional.empty?
    w << "#{buffer} << \"#{value}\"" if @token.value
    if children?
      @nodes.each { |node| node.to_s(w, buffer) }
      w << "#{buffer} << \"\\n#{indentation}\""
    end
    w << "#{buffer} << \"<![endif]\"" unless conditional.empty?
    w << "#{buffer} << \"-->\""
  end
end

# The nearest element at or above *node*, which an attribute belongs to.
def element_of(node : Node) : Node
  until node.kind == "element" || node.document?
    node = node.parent
  end
  node
end

# Builds the node tree the way the original Parser does: a node's parent is
# the nearest earlier node in a column to its left, and `else`/`when`-like
# control lines join the `if`/`case` in their own column.
def parse(text : String) : Node
  lexer = Lexer.new(text)
  document = Node.new("document", nil, Token.new)
  document.token.column_number = 1
  current = document
  controls = {} of Int32 => Node
  token = lexer.next_token
  until token.type == "EOF"
    type = token.type
    if type == "DOCTYPE"
      document.nodes << Node.new("doctype", document, token)
    elsif type == "ATTRIBUTE"
      element = element_of(current)
      raise "slang: attribute #{token.name} outside an element at line #{token.line_number}" if element.document?
      element.nodes << Node.new("attribute", element, token)
    elsif type == "SPLAT"
      element = element_of(current)
      raise "slang: *#{token.value} outside an element at line #{token.line_number}" if element.document?
      element.token.splat = token.value
    else
      parent = current
      until parent.document?
        # column number is smaller than the node we're processing
        # therefore it is the parent
        break if parent.column_number < token.column_number
        if ["ELEMENT", "CONTROL", "OUTPUT"].includes?(parent.token.type) && parent.token.inline
          break if parent.parent.column_number < token.column_number
        end
        parent = parent.parent
      end
      kind = type == "ELEMENT" ? "element" : type == "COMMENT" ? "comment" : type == "CONTROL" ? "control" : type == "CODE" ? "code" : "text"
      node = Node.new(kind, parent, token)
      if kind == "element"
        # `.name`s first and `#id` after, as the original's hash held them.
        token.classes.each { |value| node.nodes << Node.new("attribute", node, shorthand(token, "class", value)) }
        if id = token.id
          node.nodes << Node.new("attribute", node, shorthand(token, "id", id))
        end
        parent.nodes << node
      elsif kind == "control" && (last = controls[node.column_number]?) && last.allow_branch?(node)
        last.branches << node
      else
        controls[node.column_number] = node if kind == "control"
        parent.nodes << node
      end
      current = node
    end
    token = lexer.next_token
  end
  document
end

# An attribute token for an element's `.name` or `#id`.
def shorthand(element : Token, name : String, value : String) : Token
  attribute = Token.new
  attribute.type = "ATTRIBUTE"
  attribute.name = name
  attribute.value = value
  attribute.line_number = element.line_number
  attribute.column_number = element.column_number
  attribute.escaped = false
  attribute
end

def process_string(text : String, filename : String, buffer : String) : String
  w = Writer.new(filename)
  parse(text).to_s(w, buffer)
  w.lines.join("\n") + "\n"
end

def process_file(filename : String, buffer : String) : String
  process_string(File.read(filename), filename, buffer)
end

# Where `embed` reads *template* from when it is written in *caller*: the
# template itself when absolute, otherwise beside the caller.
def locate(template : String, caller : String) : String
  return template if template.starts_with?("/") || caller.empty?
  slash = caller.rindex('/')
  slash ? caller[0, slash + 1] + template : template
end

args = Program.args
raise "usage: slang/process CALLER TEMPLATE BUFFER, not #{args.size} arguments" unless args.size == 3

print process_file(locate(args[1], args[0]), args[2])
