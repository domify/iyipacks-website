module catalog

import std/json::{JSON, Any}
import std/html::{HTML}
import std/text
import toml::{parse_toml}
import slang::{Slang}

# Renders the whole site from data/catalog.toml into finished files. Nothing
# here runs on the web server: `site_files` maps each output path to its
# contents and build.iyi writes them out. The HTML is in Slang templates under
# src/views/, compiled into this program; local variables of the method that
# renders a template are visible in it. Links are relative and name each
# index.html, so the site works from any directory of a host and when its files
# are opened straight from disk. Run from the project directory.

# Catalog entries contain string-valued fields; validate them while preparing
# packages.json. data/catalog.toml remains the single source of truth.
def json_records(records : Array(Any)) : Array(Hash(String, String))
  records.map do |record|
    fields = {} of String => String
    record.as_h.each { |key, value| fields[key] = value.as_s }
    fields
  end
end

CATALOG = parse_toml(File.read("data/catalog.toml"))
PACKAGES = CATALOG["packages"].as_a.sorted_by { |pack| pack["name"].as_s.downcase }
CATEGORIES = CATALOG["categories"].as_a
CATALOG_JSON = JSON.to_json({"categories" => json_records(CATEGORIES), "packages" => json_records(CATALOG["packages"].as_a)})
STYLE = File.read("public/style.css")
SCRIPT = File.read("public/app.js")
CONTENT_SECURITY_POLICY = "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'"
FAVICON = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23d1333d'/%3E%3Ctext x='18' y='46' font-size='46' font-family='monospace' fill='%23ffffff'%3Ei%3C/text%3E%3C/svg%3E"
COMPARE_ROWS = [{"Category", "category"}, {"Compatibility", "kind"}, {"Distribution", "distribution"}, {"Description", "description"}, {"Notes", "note"}, {"Usage", "usage"}]

def esc(value : String) : String
  HTML.escape(value)
end

# A heading with the red full stop, with no space before it.
def accent(text : String) : String
  "#{esc(text)}<span class=\"accent\">.</span>"
end

def badge_class(kind : String) : String
  kind == "Native iyi" ? "native" : "crystal"
end

def category_name(slug : String) : String
  CATEGORIES.each { |c| return c["name"].as_s if c["slug"].as_s == slug }
  "All categories"
end

# *root* leads from the page back to the site's top directory: "../../" for
# packages/http/index.html. 404.html is shown at whatever path was missing,
# so it alone links from the host's root, "/".
def page(title : String, content : String, root : String) : String
  Slang.render("views/layout.slang")
end

# Every listing page carries all cards so app.js can search, filter and sort
# them in the browser; a category page hides the others for readers without
# JavaScript, whose filters are the category links.
def listing(category : String, root : String) : String
  chosen = PACKAGES.count { |pack| category.empty? || pack["category"].as_s == category }
  Slang.render("views/listing.slang")
end

def detail(pack : Any, root : String) : String
  Slang.render("views/detail.slang")
end

def comparison(root : String) : String
  Slang.render("views/compare.slang")
end

def about(root : String) : String
  Slang.render("views/about.slang")
end

def not_found(root : String) : String
  Slang.render("views/not_found.slang")
end

pub def site_files : Hash(String, String)
  files = {} of String => String
  files["index.html"] = page("Good tools for iyi", listing("", ""), "")
  CATEGORIES.each do |c|
    files["categories/#{c["slug"].as_s}/index.html"] = page(c["name"].as_s, listing(c["slug"].as_s, "../../"), "../../")
  end
  PACKAGES.each { |pack| files["packages/#{pack["slug"].as_s}/index.html"] = page(pack["name"].as_s, detail(pack, "../../"), "../../") }
  files["compare/index.html"] = page("Compare packages", comparison("../"), "../")
  files["about/index.html"] = page("About", about("../"), "../")
  files["404.html"] = page("Page not found", not_found("/"), "/")
  files["packages.json"] = CATALOG_JSON
  files["style.css"] = STYLE
  files["app.js"] = SCRIPT
  files
end
