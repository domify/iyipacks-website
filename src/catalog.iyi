module catalog

import std/json::{JSON}
import std/html::{HTML}
import std/text
import std/time::{Time}
import toml::{TOML}
import modules::{activity, ago}
import slang::{Slang}

# Renders the whole site from data/catalog.toml and data/modules.toml into
# finished files. Nothing here runs on the web server: `site_files` maps each
# output path to its contents and build.iyi writes them out. The HTML is in
# Slang templates under src/views/, compiled into this program; local
# variables of the method that renders a template are visible in it. Links
# are relative and name each index.html, so the site works from any directory
# of a host and when its files are opened straight from disk. Run from the
# project directory.

# Catalog entries contain string-valued fields; this checks that they do.
def json_records(records : Array(TOML::Any)) : Array(Hash(String, String))
  records.map do |record|
    fields = {} of String => String
    record.as_h.each { |key, value| fields[key] = value.as_s }
    fields
  end
end

CATALOG = TOML.parse(File.read("data/catalog.toml"))
CATEGORIES = CATALOG["categories"].as_a
NOW = Time.utc

# The modules `make update` imported, with the [[modules]] overrides of
# data/catalog.toml applied.
def imported_modules : Array(Hash(String, String))
  modules = [] of Hash(String, String)
  return modules unless File.exists?("data/modules.toml")
  data = TOML.parse(File.read("data/modules.toml"))
  return modules unless data["modules"]?
  overrides = CATALOG["modules"]? ? json_records(CATALOG["modules"].as_a) : [] of Hash(String, String)
  json_records(data["modules"].as_a).each do |record|
    override = overrides.find { |entry| entry["repo"].downcase == record["repo"].downcase }
    if override
      next if override["hidden"]? == "true"
      override.each { |key, value| record[key] = value unless key == "repo" || key == "hidden" }
    end
    modules << record
  end
  modules
end

# Packages from GitHub first and the standard library after them, each by name.
PACKAGES = (json_records(CATALOG["packages"].as_a) + imported_modules).sorted_by { |pack| "#{pack["distribution"] == "Standard library" ? 1 : 0} #{pack["name"].downcase}" }
PACKAGES.each do |pack|
  unless CATEGORIES.any? { |c| c["slug"].as_s == pack["category"] }
    raise "catalog: #{pack["slug"]} is in an unknown category #{pack["category"].inspect}"
  end
end
CATALOG_JSON = JSON.to_json({"categories" => json_records(CATEGORIES), "packages" => PACKAGES})
STYLE = File.read("public/style.css")
SCRIPT = File.read("public/app.js")
CONTENT_SECURITY_POLICY = "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'"
# The iyipacks mark: a package with the iyi mascot's face, its `i` eyes and
# `y` beard. Inline in the header, and the favicon as a data URI.
# Where a reader reports a package that is malicious or unsafe: GitHub, and
# this directory's own issues.
GITHUB_ABUSE = "https://docs.github.com/en/communities/maintaining-your-safety-on-github/reporting-abuse-or-spam"
REPO_URL = "https://github.com/domify/iyipacks-website"
REPORT_URL = "#{REPO_URL}/issues/new"
LOGO = File.read("public/logo.svg").strip
FAVICON = "data:image/svg+xml," + LOGO.gsub('"', "'").gsub("#", "%23").gsub("<", "%3C").gsub(">", "%3E")

def esc(value : String) : String
  HTML.escape(value)
end

# A heading with the red full stop, with no space before it.
def accent(text : String) : String
  "#{esc(text)}<span class=\"accent\">.</span>"
end

# A field the package may not have, such as the GitHub numbers of a
# standard module.
def field(pack : Hash(String, String), key : String) : String
  pack[key]? || ""
end

def std?(pack : Hash(String, String)) : Bool
  pack["distribution"] == "Standard library"
end

def badge(pack : Hash(String, String)) : String
  return "Standard library" if std?(pack)
  version = field(pack, "version")
  version.empty? ? "No release" : version
end

def badge_class(pack : Hash(String, String)) : String
  std?(pack) ? "std" : "module"
end

# The line of numbers on a package card.
def summary(pack : Hash(String, String)) : String
  return "Ships with iyi" if std?(pack)
  parts = ["★ #{field(pack, "stars")}"]
  parts << "used by #{field(pack, "dependents")}" unless field(pack, "dependents") == "0"
  parts << "updated #{ago(field(pack, "pushed"), NOW)}" unless field(pack, "pushed").empty?
  parts.join(" · ")
end

def category_name(slug : String) : String
  CATEGORIES.each { |c| return c["name"].as_s if c["slug"].as_s == slug }
  "All categories"
end

# *root* leads from the page back to the site's top directory: "../../" for
# packages/http/index.html. 404.html is shown at whatever path was missing,
# so it alone links from the host's root, "/".
def page(title : String, content : String, root : String) : String
  Slang.render("views/layout.slang")
end

# Every listing page carries all cards so app.js can search, filter and sort
# them in the browser; a category page hides the others for readers without
# JavaScript, whose filters are the category links.
def listing(category : String, root : String) : String
  chosen = PACKAGES.count { |pack| category.empty? || pack["category"] == category }
  Slang.render("views/listing.slang")
end

def detail(pack : Hash(String, String), root : String) : String
  Slang.render("views/detail.slang")
end

def about(root : String) : String
  Slang.render("views/about.slang")
end

def not_found(root : String) : String
  Slang.render("views/not_found.slang")
end

pub def site_files : Hash(String, String)
  files = {} of String => String
  files["index.html"] = page("iyi packages", listing("", ""), "")
  CATEGORIES.each do |c|
    files["categories/#{c["slug"].as_s}/index.html"] = page(c["name"].as_s, listing(c["slug"].as_s, "../../"), "../../")
  end
  PACKAGES.each { |pack| files["packages/#{pack["slug"]}/index.html"] = page(pack["name"], detail(pack, "../../"), "../../") }
  files["about/index.html"] = page("About", about("../"), "../")
  files["404.html"] = page("Page not found", not_found("/"), "/")
  files["packages.json"] = CATALOG_JSON
  files["style.css"] = STYLE
  files["app.js"] = SCRIPT
  files
end
